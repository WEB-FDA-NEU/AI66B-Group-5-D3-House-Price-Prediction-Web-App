# Set these in the process environment; the runner does not automatically load .env.
# Empty DATABASE_URL uses backend/homeval.db.
DATABASE_URL=
# Empty JWT_SECRET generates a persistent ignored local secret. Set a strong secret for deployment.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500
# run.py enables sandbox for local review. Set 0 to disable simulated checkout.
HOMEVAL_DEMO_BILLING=0
# HOUSING_DATASET_PATH=C:/path/to/vietnam_housing_dataset.csv
# MODEL_ARTIFACT_DIR=C:/path/to/artifacts
